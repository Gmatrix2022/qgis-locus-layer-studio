授权：本项目自建，供本机内部与插件叠加层使用。地图数据版权 © OpenStreetMap contributors（ODbL）。
-->
<rendertheme xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             map-background="#00000000" map-background-outside="#00000000"
             version="5" xmlns="http://mapsforge.org/renderTheme"
             xsi:schemaLocation="http://mapsforge.org/renderTheme https://raw.githubusercontent.com/mapsforge/mapsforge/master/resources/renderTheme.xsd">

<stylemenu id="sat-menu" defaultvalue="sat-outdoor" defaultlang="en">
    <layer id="sat-outdoor" visible="true">
        <name lang="en" value="Satellite outdoor overlay" />
        <name lang="zh" value="卫星叠加 · 户外风" />
        <cat id="hatch" />
        <cat id="water" />
        <cat id="contour" />
        <cat id="roads_major" />
        <cat id="roads_minor" />
        <cat id="tracks" />
        <cat id="paths" />
        <cat id="ferries" />
        <cat id="labels" />
    </layer>
</stylemenu>

<rule cat="water" e="way" k="natural" v="water" closed="yes" zoom-min="10">
    <area fill="#4D2E9BD8" />
</rule>
<rule cat="water" e="way" k="landuse" v="reservoir|basin" closed="yes" zoom-min="11">
    <area fill="#4D2E9BD8" />
</rule>
<rule cat="water" e="way" k="waterway" v="river" zoom-min="8">
    <rule e="way" k="*" v="*" zoom-min="8" zoom-max="12">
        <line stroke="#B32E9BD8" stroke-width="1.0" />
    </rule>
    <rule e="way" k="*" v="*" zoom-min="13">
        <line stroke="#B32E9BD8" stroke-width="1.8" />
    </rule>
</rule>
<rule cat="water" e="way" k="waterway" v="canal" zoom-min="10">
    <line stroke="#B32E9BD8" stroke-width="1.3" />
</rule>
<rule cat="water" e="way" k="waterway" v="stream|ditch|drain" zoom-min="11">
    <rule e="way" k="*" v="*" zoom-min="11" zoom-max="13">
        <line stroke="#993FB0E0" stroke-width="0.6" />
    </rule>
    <rule e="way" k="*" v="*" zoom-min="14">
        <line stroke="#993FB0E0" stroke-width="0.9" />
    </rule>
</rule>

<rule cat="contour" e="any" k="contour_ext" v="*" zoom-min="12">
    <rule e="way" k="contour_ext" v="elevation_minor" zoom-min="13">
        <line stroke="#5C6E4A2A" stroke-width="0.20" curve="cubic" />
    </rule>
    <rule e="way" k="contour_ext" v="elevation_medium">
        <line stroke="#7A7A5230" stroke-width="0.42" curve="cubic" />
    </rule>
    <rule e="way" k="contour_ext" v="elevation_major">
        <line stroke="#99703F1E" stroke-width="0.75" curve="cubic" />
    </rule>
    <rule e="way" k="contour_ext" v="elevation_major" zoom-min="13" zoom-max="15">
        <pathText k="ele" font-style="bold" font-size="8" fill="#6E4A22" stroke="#D9FFFFFF" stroke-width="1.5"
                  repeat-start="60" repeat-gap="220" text-orientation="left" />
    </rule>
</rule>

<rule cat="roads_major" e="way" k="highway" v="motorway|motorway_link|trunk|trunk_link" zoom-min="8">
    <rule e="way" k="*" v="*" zoom-min="8" zoom-max="11">
        <line stroke="#B3241A12" stroke-width="3.2" stroke-linecap="round" />
    </rule>
    <rule e="way" k="*" v="*" zoom-min="12">
        <line stroke="#B3241A12" stroke-width="5.0" stroke-linecap="round" />
    </rule>
</rule>
<rule cat="roads_major" e="way" k="highway" v="primary|primary_link" zoom-min="8">
    <rule e="way" k="*" v="*" zoom-min="8" zoom-max="11">
        <line stroke="#B3221810" stroke-width="2.4" stroke-linecap="round" />
    </rule>
    <rule e="way" k="*" v="*" zoom-min="12">
        <line stroke="#B3221810" stroke-width="3.8" stroke-linecap="round" />
    </rule>
</rule>
<rule cat="roads_major" e="way" k="highway" v="secondary|secondary_link" zoom-min="9">
    <rule e="way" k="*" v="*" zoom-min="9" zoom-max="11">
        <line stroke="#B32A2018" stroke-width="1.8" stroke-linecap="round" />
    </rule>
    <rule e="way" k="*" v="*" zoom-min="12">
        <line stroke="#B32A2018" stroke-width="2.6" stroke-linecap="round" />
    </rule>
</rule>
<rule cat="roads_minor" e="way" k="highway" v="tertiary|tertiary_link" zoom-min="10">
    <rule e="way" k="*" v="*" zoom-min="10" zoom-max="11">
        <line stroke="#B32A2018" stroke-width="1.4" stroke-linecap="round" />
    </rule>
    <rule e="way" k="*" v="*" zoom-min="12">
        <line stroke="#B32A2018" stroke-width="2.0" stroke-linecap="round" />
    </rule>
</rule>
<rule cat="roads_minor" e="way" k="highway" v="unclassified|residential|living_street|road" zoom-min="11">
    <rule e="way" k="*" v="*" zoom-min="11" zoom-max="12">
        <line stroke="#A62A2018" stroke-width="1.1" stroke-linecap="round" />
    </rule>
    <rule e="way" k="*" v="*" zoom-min="13">
        <line stroke="#A62A2018" stroke-width="1.6" stroke-linecap="round" />
    </rule>
</rule>
<rule cat="roads_minor" e="way" k="highway" v="service|pedestrian" zoom-min="13">
    <line stroke="#992A2018" stroke-width="1.2" stroke-linecap="round" />
</rule>
<rule cat="tracks" e="way" k="highway" v="track" zoom-min="10">
    <line stroke="#B3472E14" stroke-width="1.8" stroke-dasharray="8,3" stroke-linecap="butt" />
</rule>
<rule cat="paths" e="way" k="highway" v="path|footway|bridleway|cycleway|steps" zoom-min="11">
    <line stroke="#8C000000" stroke-width="1.3" stroke-dasharray="4,3" stroke-linecap="butt" />
</rule>
<rule cat="ferries" e="way" k="route" v="ferry" zoom-min="8">
    <line stroke="#B33366B3" stroke-width="1.2" stroke-dasharray="6,4" stroke-linecap="butt" />
</rule>

<rule cat="roads_major" e="way" k="highway" v="motorway|motorway_link|trunk|trunk_link" zoom-min="8">
    <rule e="way" k="*" v="*" zoom-min="8" zoom-max="11">
        <line stroke="#FFD8613A" stroke-width="1.9" stroke-linecap="round" />
    </rule>
    <rule e="way" k="*" v="*" zoom-min="12">
        <line stroke="#FFF07A3C" stroke-width="3.2" stroke-linecap="round" />
    </rule>
</rule>
<rule cat="roads_major" e="way" k="highway" v="primary|primary_link" zoom-min="8">
    <rule e="way" k="*" v="*" zoom-min="8" zoom-max="11">
        <line stroke="#FFE8A33C" stroke-width="1.3" stroke-linecap="round" />
    </rule>
    <rule e="way" k="*" v="*" zoom-min="12">
        <line stroke="#FFF2B44A" stroke-width="2.2" stroke-linecap="round" />
    </rule>
</rule>
<rule cat="roads_major" e="way" k="highway" v="secondary|secondary_link" zoom-min="9">
    <rule e="way" k="*" v="*" zoom-min="9" zoom-max="11">
        <line stroke="#FFF6E08A" stroke-width="0.9" stroke-linecap="round" />
    </rule>
    <rule e="way" k="*" v="*" zoom-min="12">
        <line stroke="#FFF9EBA8" stroke-width="1.5" stroke-linecap="round" />
    </rule>
</rule>
<rule cat="roads_minor" e="way" k="highway" v="tertiary|tertiary_link" zoom-min="10">
    <rule e="way" k="*" v="*" zoom-min="10" zoom-max="11">
        <line stroke="#FFF7F3EC" stroke-width="0.7" stroke-linecap="round" />
    </rule>
    <rule e="way" k="*" v="*" zoom-min="12">
        <line stroke="#FFFFFFFF" stroke-width="1.2" stroke-linecap="round" />
    </rule>
</rule>
<rule cat="roads_minor" e="way" k="highway" v="unclassified|residential|living_street|road" zoom-min="11">
    <rule e="way" k="*" v="*" zoom-min="11" zoom-max="12">
        <line stroke="#FFF3EFE8" stroke-width="0.5" stroke-linecap="round" />
    </rule>
    <rule e="way" k="*" v="*" zoom-min="13">
        <line stroke="#FFFFFFFF" stroke-width="0.8" stroke-linecap="round" />
    </rule>
</rule>
<rule cat="roads_minor" e="way" k="highway" v="service|pedestrian" zoom-min="13">
    <line stroke="#FFEFEAE2" stroke-width="0.6" stroke-linecap="round" />
</rule>
<rule cat="tracks" e="way" k="highway" v="track" zoom-min="10">
    <line stroke="#FFF2E4C4" stroke-width="1.1" stroke-dasharray="8,3" stroke-linecap="butt" />
</rule>
<rule cat="paths" e="way" k="highway" v="path|footway|bridleway|cycleway|steps" zoom-min="11">
    <rule e="way" k="highway" v="steps" zoom-min="13">
        <line stroke="#FFE86A3C" stroke-width="0.8" stroke-dasharray="2,3" stroke-linecap="butt" />
    </rule>
    <rule e="way" k="highway" v="path|footway|bridleway|cycleway" zoom-min="11" zoom-max="13">
        <line stroke="#FFE05A2E" stroke-width="0.7" stroke-dasharray="4,3" stroke-linecap="butt" />
    </rule>
    <rule e="way" k="highway" v="path|footway|bridleway|cycleway" zoom-min="14">
        <line stroke="#FFE05A2E" stroke-width="0.9" stroke-dasharray="5,4" stroke-linecap="butt" />
    </rule>
</rule>

<rule cat="labels" e="node" k="boundary|leisure" v="protected_area|national_park|nature_reserve" zoom-min="9">
    <caption k="name" font-style="italic" font-size="13" fill="#6B5220" stroke="#D9FFFFFF" stroke-width="3" />
</rule>
<rule cat="labels" e="node" k="natural|landuse" v="wood|forest|scrub|heath|grassland|scree|bare_rock|glacier" zoom-min="11">
    <rule e="any" k="bBoxWeight" v="xxxlarge|xxlarge|xlarge" zoom-min="11">
        <caption k="name" font-style="italic" font-size="15" fill="#3F5A2A" stroke="#D9FFFFFF" stroke-width="3" />
    </rule>
    <rule e="any" k="bBoxWeight" v="large" zoom-min="11">
        <caption k="name" font-style="italic" font-size="12" fill="#3F5A2A" stroke="#D9FFFFFF" stroke-width="3" />
    </rule>
    <rule e="any" k="bBoxWeight" v="mid|small" zoom-min="13">
        <caption k="name" font-style="italic" font-size="10" fill="#3F5A2A" stroke="#CCFFFFFF" stroke-width="2.5" />
    </rule>
</rule>
<rule cat="labels" e="node" k="natural|landuse" v="water|reservoir|basin" zoom-min="12">
    <caption k="name" font-style="italic" font-size="11" fill="#12405E" stroke="#D9FFFFFF" stroke-width="3" />
</rule>
<rule cat="labels" e="node" k="natural" v="peak|volcano" zoom-min="10">
    <caption k="name" font-style="bold" font-size="11" fill="#3A2A12" stroke="#E8FFFFFF" stroke-width="3" />
</rule>
<rule cat="labels" e="node" k="natural" v="saddle" zoom-min="13">
    <caption k="name" font-size="10" fill="#3A2A12" stroke="#D9FFFFFF" stroke-width="2.5" />
</rule>
<rule cat="labels" e="node" k="place" v="city" zoom-min="8">
    <caption k="name" font-style="bold" font-size="14" fill="#241C10" stroke="#E8FFFFFF" stroke-width="3" />
</rule>
<rule cat="labels" e="node" k="place" v="town" zoom-min="9">
    <caption k="name" font-style="bold" font-size="12" fill="#241C10" stroke="#E8FFFFFF" stroke-width="3" />
</rule>
<rule cat="labels" e="node" k="place" v="village" zoom-min="12">
    <caption k="name" font-size="11" fill="#2A2118" stroke="#D9FFFFFF" stroke-width="3" />
</rule>
<rule cat="labels" e="node" k="place" v="hamlet|isolated_dwelling" zoom-min="14">
    <caption k="name" font-size="10" fill="#2A2118" stroke="#CCFFFFFF" stroke-width="2.5" />
</rule>
<rule cat="labels" e="node" k="tourism" v="alpine_hut|wilderness_hut" zoom-min="12">
    <caption k="name" font-size="10" fill="#6B2A0E" stroke="#E8FFFFFF" stroke-width="3" />
</rule>
<rule cat="labels" e="node" k="amenity" v="shelter" zoom-min="14">
    <caption k="name" font-size="9" fill="#3A3020" stroke="#CCFFFFFF" stroke-width="2.5" />
</rule>
<rule cat="labels" e="way" k="waterway" v="river|canal|stream" zoom-min="14">
    <pathText k="name" font-style="italic" font-size="10" fill="#12405E" stroke="#D9FFFFFF" stroke-width="2"
              repeat-start="80" repeat-gap="250" text-orientation="left" />
</rule>

</rendertheme>
